DATABASE_URL=url_supabase_aqui
DJANGO_DEBUG=True

FRONTEND_URL=http://localhost:5173

# Deixe EMAIL_HOST vazio e o e-mail de recuperacao de senha cai no console, que
# no Vercel significa que ele fica no log da funcao e ninguem recebe. A tela de
# recuperar senha avisa quando esta assim.
# Para entregar de verdade, preencha EMAIL_HOST, EMAIL_HOST_USER e
# EMAIL_HOST_PASSWORD. O backend de envio e escolhido sozinho a partir disso,
# entao EMAIL_BACKEND so e necessario para forcar outra coisa.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
